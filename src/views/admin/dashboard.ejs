<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Dashboard</title>
    <link rel="stylesheet" href="/style.css">
</head>
    <body>
        <%- include('../partials/navbar') %>

        <main class="admin-dashboard">
            <h1>Welcome, Admin!</h1>
            <p>Here is an overview of system activity</p>

            <div class="admin-dashboard-card-container">
                <div class="admin-dashboard-card">
                    <img src="/room-icon.png" width="60" height="60">
                    <h2>Rooms</h2>
                    <p>10</p>
                </div>

                <div class="admin-dashboard-card">
                    <img src="/checkmark-icon.png" width="60" height="60">
                    <h2>Bookings</h2>
                    <p>10</p>
                </div>

                <div class="admin-dashboard-card">
                    <img src="/user-icon.png" width="60" height="60">
                    <h2>Users</h2>
                    <p>10</p>
                </div>
            </div>

        </main>
            
    </body>
</html>