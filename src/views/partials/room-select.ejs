<label for="roomId">Select Room</label>
<select name="roomId" id="roomId"></select>

<script>
    // Directly use roomId in other .ejs files.
    const roomId = document.getElementById("roomId");

    fetch('/rooms/all')
        .then(response => response.json())
        .then(rooms => {
            rooms.forEach((room, index) => {
                let option = document.createElement("option");
                option.value = room._id;
                option.textContent = room.roomName;

                if(index === 0) {
                    option.selected = true;
                }

                roomId.appendChild(option);
                //console.log(`Room Id: ${roomId.value}`);
            });

            // Fetch the first room when loaded.
            if (typeof fetchOneRoom === "function") {
                fetchOneRoom();
            }
        })
        .catch(error => console.error("Error loading rooms:", error)); 
</script>