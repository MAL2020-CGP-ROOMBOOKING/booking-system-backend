<label for="roomId">Select Room</label>
<select name="roomId" id="roomId"></select>

<script>
    // <select> component
    const roomId = document.getElementById("roomId");

    function fetchOneRoom() {
        const room_id = roomId.value;
        if (!roomId) return;
        fetch(`/rooms/${room_id}`)
            .then(response => response.json())
            .then(data => {
                document.getElementById("roomName").textContent = data.roomName;
                document.getElementById("description").textContent = `Description: ${data.description}`;
                document.getElementById("pax").textContent = `Pax: ${data.pax}`;
            })
    };

    fetch('/rooms/all')
        .then(response => response.json())
        .then(rooms => {
            rooms.forEach((room, index) => {
                let option = document.createElement("option");
                option.value = room._id;
                option.textContent = room.roomName;

                if(index === 0) {
                    option.selected = true;
                }

                roomId.appendChild(option);
            });
            
            fetchOneRoom();
        })
        .catch(error => console.error("Error loading rooms:", error)); 

    roomId.addEventListener("change", function() {
        fetchOneRoom();
    });
</script>