<div id="week-loader">
    <button type="button" onclick="getPrevWeek()">Previous Week</button>
    <p id="displayedWeek">Current Week</p>
    <button type="button" onclick="getNextWeek()">Next Week</button>
</div>

<table id="timetable" class="timetable">
    <thead>
        <tr id="timeslot-row">
            <th></th>
        </tr>
    </thead>
</table>

<!-- Current Week Display -->
<script>
    let currentMonday;
    let currentWeek; // Used for Room Display?

    function getWeek(offsetDays = 0) {
        let baseDate;

        if (currentMonday) {
            // Continue from the last displayed Monday
            baseDate = new Date(currentMonday);
        } else {
            // Calculate the current Monday if no previous week exists
            const today = new Date();
            const dayOfWeek = today.getDay(); // 0 (Sunday) to 6 (Saturday)
            baseDate = new Date(today);
            baseDate.setDate(baseDate.getDate() - (dayOfWeek === 0 ? 6 : dayOfWeek - 1));
        }

        // Move forward or backward
        baseDate.setDate(baseDate.getDate() + offsetDays);
        currentMonday = new Date(baseDate); // Update reference Monday

        // Generate the Monday-Friday week
        const weekDates = [];
        for (let i = 0; i < 5; i++) {
            const weekDay = new Date(baseDate);
            weekDay.setDate(baseDate.getDate() + i);
            weekDates.push(weekDay.toISOString().split('T')[0]);
        }
        return weekDates;
    }

    function reformatDate(date) {
        const [year, month, day] = date.split("-");
        return `${day}/${month}/${year}`;
    }

    function updateWeekDisplay(offsetDays) {
        const week = getWeek(offsetDays);
        const monday = reformatDate(week[0]);
        const friday = reformatDate(week[4]);
        document.getElementById("displayedWeek").textContent = `${monday} - ${friday}`;
        return week
    }

    function getNextWeek() {
        currentWeek = updateWeekDisplay(7);
        console.log(currentWeek);
    }

    function getPrevWeek() {
        currentWeek = updateWeekDisplay(-7);
        console.log(currentWeek);
    }

    document.addEventListener("DOMContentLoaded", function () {
        currentWeek = updateWeekDisplay(0); // Show current week on load
        console.log(currentWeek);
    });
</script>


<!-- Reservation Schedule Display -->
<script>
    const days = ['MON', 'TUE', 'WED', 'THU', 'FRI'];
    const timeSlot = ['8:30', '9:00', '9:30', '10:00', '10:30', '11:00', '11:30', '12:00', '12:30', '13:00', '13:30', '14:00', '14:30', '15:00', '15:30', '16:00', '16:30', '17:00', '17:30'];

    const timetable = document.getElementById('timetable');
    const timeSlotRow = document.getElementById('timeslot-row');

    timeSlot.forEach(time => {
        timeSlotHead = document.createElement("th");
        timeSlotHead.append(document.createTextNode(time));
        timeSlotRow.append(timeSlotHead);
    });

    days.forEach(day => {
        dayRow = document.createElement("tr");
        dayData = document.createElement("td");
        dayData.append(document.createTextNode(day));
        dayRow.append(dayData);
        timetable.append(dayRow);
    });
    
    // booked time and day for a room is generated through this timetable
</script>