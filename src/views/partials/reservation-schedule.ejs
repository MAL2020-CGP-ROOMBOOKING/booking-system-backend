<div class="week-loader">
    <button type="button" id="getPrevWeek">Previous Week</button>
    <p id="displayed-week">Current Week</p>
    <button type="button" id="getNextWeek">Next Week</button>
</div>

<table class="timetable" id="timetable">
</table>

<!-- Load Current Week -->
<script>
    const days = ['MON', 'TUE', 'WED', 'THU', 'FRI'];
    const timeSlot = ['08:30', '09:00', '09:30', '10:00', '10:30', '11:00', '11:30', '12:00', '12:30', '13:00', '13:30', '14:00', '14:30', '15:00', '15:30', '16:00', '16:30', '17:00', '17:30'];

    let currentMonday;
    let currentWeek;
    let currentDayDate = new Map();

    function getWeek(offsetDays = 0) {
        let baseDate;

        if (currentMonday) {
            // Continue from the last displayed Monday
            baseDate = new Date(currentMonday);
        } else {
            // Calculate the current Monday if no current Monday exist
            const today = new Date();
            const dayOfWeek = today.getDay();
            baseDate = new Date(today);
            baseDate.setDate(baseDate.getDate() - (dayOfWeek === 0 ? 6 : dayOfWeek - 1));
            baseDate.setHours(baseDate.getHours() + 8); // Malaysia is 8 hours ahead of UTC (JS default timezone)
        }

        // Move forward or backward
        baseDate.setDate(baseDate.getDate() + offsetDays);
        currentMonday = new Date(baseDate);

        // Generate the Monday-Friday week
        const weekDates = [];
        for (let i = 0; i < 5; i++) {
            const weekDay = new Date(baseDate);
            weekDay.setDate(baseDate.getDate() + i);
            weekDates.push(weekDay.toISOString().split('T')[0]);
        }
        return weekDates;
    }

    function reformatDate(date) {
        const [year, month, day] = date.split("-");
        return `${day}/${month}/${year}`;
    }

    function updateWeekDisplay(offsetDays) {
        const week = getWeek(offsetDays);
        const monday = reformatDate(week[0]);
        const friday = reformatDate(week[4]);
        document.getElementById("displayed-week").textContent = `${monday} - ${friday}`;
        return week
    }

    function genDayDateMap() {
        const i = [0, 1, 2, 3, 4];

        i.forEach((i) => {
            currentDayDate.set(days[i], currentWeek[i]);
        });
    }

    // Show current week on page load
    document.addEventListener("DOMContentLoaded", function () {
        currentWeek = updateWeekDisplay(0);
        genDayDateMap();
    });

    document.getElementById("getPrevWeek").addEventListener("click", function() {
        currentWeek = updateWeekDisplay(-7);
        genDayDateMap();
        updateTimetable();
    });

    document.getElementById("getNextWeek").addEventListener("click", function() {
        currentWeek = updateWeekDisplay(7);
        genDayDateMap();
        updateTimetable();
    });
</script>


<!-- Reservation Schedule Display -->
<script>
    const timetable = document.getElementById('timetable');
    const timeSlotRow = document.getElementById('timeslot-row');

    let extractedData;

    function genTimetable() {
        // Table Head
        const thead = document.createElement("thead");
        const timeSlotRow = document.createElement("tr");

        timeSlotRow.appendChild(document.createElement("th"));

        timeSlot.forEach(time => {
            timeSlotHead = document.createElement("th");
            timeSlotHead.append(document.createTextNode(time));
            timeSlotRow.append(timeSlotHead);
        });

        thead.appendChild(timeSlotRow);
        timetable.appendChild(thead);

        // Table Body
        const tbody = document.createElement("tbody");

        days.forEach(day => {
            dayRow = document.createElement("tr");
            dayData = document.createElement("td");
            dayData.style.backgroundColor = "#CCCCCC";
            dayData.append(document.createTextNode(day));
            dayRow.append(dayData);

            timeSlot.forEach(time => {
                dayTimeData = document.createElement("td");

                extractedData.forEach(data => {
                    if (data.day == day && time >= data.startTime && time <= data.endTime) {
                        dayTimeData.style.backgroundColor = "#0D6EFD";
                    } else {
                        dayTimeData.style.backgroundColor = "#E5E5E5";
                    }
                });

                if (extractedData === undefined || extractedData.length == 0) {
                    dayTimeData.style.backgroundColor = "#E5E5E5";
                }

                dayRow.append(dayTimeData);
            })

            tbody.appendChild(dayRow);
        });

        timetable.appendChild(tbody);
    }

    function updateTimetable() {
        timetable.innerHTML = "";
        getRoomSchedule();
    }

    function getRoomSchedule() {
        let params = new URLSearchParams();

        params.append("roomId", globalRoomId);
        currentWeek.forEach(date => params.append("dates", date));

        fetch(`/reservations?${params.toString()}`)
            .then(res => res.json())
            .then(data => {
                const extracted = data.map(reservation => ({
                    day: reservation.day,
                    date: reservation.date,
                    startTime: reservation.startTime,
                    endTime: reservation.endTime
                }));

                extractedData = extracted;
                genTimetable();
            });
    }

    roomId.addEventListener("change", function() {
        fetchOneRoom();
        updateTimetable();
    });

</script>