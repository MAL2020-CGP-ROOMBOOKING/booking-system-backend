<!DOCTYPE html>
<html>

<head>
    <title>Create Reservation</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <%- include('../partials/back-header') %>
    
    <main class="reservation-main">
        <h1>Book a Room</h1>
        <p>Select a room to view its weekly schedule and make a booking.</p>

        <form action="/reservations/create" method="post">

            <div class="reservation-top">
                <div class="user-input">
                    <%- include('../partials/room-select') %>
                    
                    <label for="date">Date</label>
                    <input type="date" name="date" id="date" required>

                    <%- include('../partials/time-select', {value: 'startTime'}) %>
                    <%- include('../partials/time-select', {value: 'endTime'}) %>
                </div>

                <div class="room-info">
                    <h2 id="roomName"></h2>
                    <p id="description"></p>
                    <p id="pax"></p>
                </div>
            </div>
            
            <%- include('../partials/reservation-schedule') %>
            <input type="submit" value="Book">
        </form>
    </main>
</body>
</html>