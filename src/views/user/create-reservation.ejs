<!DOCTYPE html>
<html>
<head>
    <title>Create Reservation</title>
    <link rel="stylesheet" href="/style.css">
</head>
    <body>

        <nav class="topnav">
            <h1>Create Reservation</h1>
        </nav>
        
        <form action="/reservations/create" method="post">

            <h2>Create Reservation</h2>

            <!-- Show selected room details -->

            <input type="date" name="reserveDate" required><br><br>

            <%- include('../partials/time-select', {name: 'startTime', id: 'startTime'}) %>

            <%- include('../partials/time-select', {name: 'endTime', id: 'endTime'}) %>

            <input type="submit" value="Reserve">
        </form>
            
    </body>
</html>