<!DOCTYPE html>
<html>
<head>
    <title>Create Reservation</title>
    <link rel="stylesheet" href="/style.css">
</head>
    <body>

        <header class="back-header">
            <a onclick="history.back()">⇐ Back to Dashboard</a>
        </header>
        
        <main class="reservation-main">
            <h1>Book a Room</h1>
            <p>Select a room to view its weekly schedule and make a booking.</p> <br>

            <form action="post">

                <label for="selectedRoom">Select Room</label>

                <select name="selectedRoom" id="selectedRoom">
                    <option value="Meeting Room A">Meeting Room A</option>
                </select>

                <div id="week-loader">
                    <button>Previous Week</button>
                    <span id="currentWeek">Current Week</span>
                    <button>Next Week</button>
                </div>

                <%- include('../partials/reservation-schedule.ejs') %>

                <input type="submit" value="Book">

            </form>
        </main>

        <!-- Current Week Display -->
        <script>
            function getCurrentWeek() {
                monday = reformatDate(getMonday());
                friday = reformatDate(getFriday());
                currentWeek = `${monday} - ${friday}`;
                return currentWeek;
            }
            function getMonday() {
                const today = new Date();
                const dayOfWeek = today.getDay(); // 0 (Sunday) to 6 (Saturday)
                const diff = dayOfWeek === 0 ? -6 : 1 - dayOfWeek; // Adjust if today is Sunday
                const monday = new Date(today);
                monday.setDate(today.getDate() + diff + 1); // Move to Monday, + 1 because Malaysia is 1 day ahead of default timezone.
                return monday.toISOString().split("T")[0]; // Format as YYYY-MM-DD
            }
            function getFriday() {
                const today = new Date();
                const dayOfWeek = today.getDay();
                const diff = dayOfWeek === 0 ? 5 : 5 - dayOfWeek;
                const friday = new Date(today);
                friday.setDate(today.getDate() + diff + 1); // Move to Friday
                return friday.toISOString().split("T")[0];
            }
            function reformatDate(date) {
                const [year, month, day] = date.split("-");
                reformattedDate = `${day}/${month}/${year}`;
                return reformattedDate;
            }
        
            document.addEventListener("DOMContentLoaded", function() {
                currentWeek = getCurrentWeek();
                document.getElementById("currentWeek").textContent = `${currentWeek}`;
            });
        </script>
        
    </body>
</html>